{
  "name": "pinnote-markdown",
  "version": "1.0.0",
  "description": "Obsidian-like Markdown Take Note app for Windows with Always-On-Top screen pinning",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:dir": "electron-builder --win dir",
    "package": "electron-packager . PinNote --platform=win32 --arch=x64 --out=dist --overwrite",
    "test": "node --test \"test/**/*.test.js\""
  },
  "keywords": [
    "markdown",
    "sticky-notes",
    "obsidian",
    "always-on-top",
    "windows",
    "note-taking"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "build": {
    "appId": "com.pinnote.app",
    "productName": "PinNote",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "sample-vault/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PinNote"
    },
    "portable": {
      "artifactName": "PinNote-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "highlight.js": "^11.9.0",
    "katex": "^0.16.10",
    "marked": "^12.0.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^29.1.5",
    "electron-builder": "^26.15.3",
    "jsdom": "^25.0.1"
  }
}
